{
  "model": {
    "type": "select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "minez:endeavour",
        "model": {
          "type": "model",
          "model": "item/swords/endeavour"
        }
      },
      {
        "when": "minez:gamble",
        "model": {
          "type": "model",
          "model": "item/swords/gamble"
        }
      }
    ],
    "fallback": {
      "type": "select",
      "property": "component",
      "component": "item_name",
      "cases": [
        {
          "when": {
            "text": "Endeavour",
            "bold": true
          },
          "model": {
            "type": "model",
            "model": "item/swords/endeavour"
          }
        },
        {
          "when": {
            "text": "Gamble",
            "bold": true
          },
          "model": {
            "type": "model",
            "model": "item/swords/gamble"
          }
        }
      ],
      "fallback": {
        "type": "model",
        "model": "minecraft:item/stone_sword"
      }
    }
  }
}
