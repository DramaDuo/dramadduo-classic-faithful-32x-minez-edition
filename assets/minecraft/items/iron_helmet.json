{
  "model": {
    "type": "select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "minez:binding_helmet",
        "model": {
          "type": "model",
          "model": "item/helmets/binding_helmet"
        }
      },
      {
        "when": "minez:gorgons_gaze",
        "model": {
          "type": "model",
          "model": "item/helmets/gorgons_gaze"
        }
      },
      {
        "when": "minez:miners_lamp",
        "model": {
          "type": "model",
          "model": "item/helmets/miners_lamp"
        }
      }
    ],
    "fallback": {
      "type": "select",
      "property": "component",
      "component": "custom_name",
      "cases": [
        {
          "when": {
            "italic": false,
            "text": "Binding Helmet",
            "bold": true
          },
          "model": {
            "type": "model",
            "model": "item/helmets/binding_helmet"
          }
        },
        {
          "when": {
            "italic": false,
            "text": "Gorgon's Gaze",
            "bold": true
          },
          "model": {
            "type": "model",
            "model": "item/helmets/gorgons_gaze"
          }
        },
        {
          "when": {
            "italic": false,
            "text": "Miner's Lamp",
            "bold": true
          },
          "model": {
            "type": "model",
            "model": "item/helmets/miners_lamp"
          }
        }
      ],
      "fallback": {
        "type": "select",
        "property": "component",
        "component": "enchantments",
        "cases": [
          {
            "when": {
              "minecraft:respiration": 1
            },
            "model": {
              "type": "model",
              "model": "item/helmets/respiration_helmet"
            }
          },
          {
            "when": {
              "minecraft:projectile_protection": 1
            },
            "model": {
              "type": "model",
              "model": "item/helmets/projectile_protection_helmet"
            }
          }
        ],
        "fallback": {
          "type": "model",
          "model": "minecraft:item/iron_helmet"
        }
      }
    }
  }
}
