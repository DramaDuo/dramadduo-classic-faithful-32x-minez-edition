              "type": "model",
              "model": "item/chestplates/fire_protection_chestplate"
            }
          }
        ],
        "fallback": {
          "type": "model",
          "model": "minecraft:item/iron_chestplate"
        }
      },
      "cases": [
        {
          "when": {
            "italic": false,
            "text": "Agni's Wrath",
