{
  "model": {
    "type": "select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "minez:frost_walker",
        "model": {
          "type": "model",
          "model": "item/boots/frost_walker"
        }
      },
      {
        "when": "minez:penguin_feet",
        "model": {
          "type": "model",
          "model": "item/boots/penguin_feet"
        }
      }
    ],
    "fallback": {
      "type": "select",
      "property": "component",
      "component": "custom_name",
      "cases": [
        {
          "when": {
            "italic": false,
            "text": "Frost Walker",
            "bold": true
          },
          "model": {
            "type": "model",
            "model": "item/boots/frost_walker"
          }
        },
        {
          "when": {
            "italic": false,
            "text": "Penguin Feet",
            "bold": true
          },
          "model": {
            "type": "model",
            "model": "item/boots/penguin_feet"
          }
        }
      ],
      "fallback": {
        "type": "select",
        "property": "component",
        "component": "enchantments",
        "cases": [
          {
            "when": {
              "minecraft:projectile_protection": 1
            },
            "model": {
              "type": "model",
              "model": "item/boots/projectile_protection_boots"
            }
          },
          {
            "when": {
              "minecraft:depth_strider": 1
            },
            "model": {
              "type": "model",
              "model": "item/boots/depth_strider_boots"
            }
          },
          {
            "when": {
              "minecraft:feather_falling": 4
            },
            "model": {
              "type": "model",
              "model": "item/boots/feather_falling_boots"
            }
          }
        ],
        "fallback": {
          "type": "model",
          "model": "minecraft:item/iron_boots"
        }
      }
    }
  }
}
